# Listener and database
HOST=127.0.0.1
PORT=8787
DOOMSDAY_DB_PATH=./data/doomsday.sqlite3
# Optional managed PostgreSQL. When set, this replaces SQLite.
DATABASE_URL=
SESSION_DAYS=30
# Capacitor's local iOS and Android webview origins; keep this list exact.
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
# Set true when served over HTTPS
COOKIE_SECURE=false
# Enable only when the trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Twilio Verify (SMS OTP). Create a Verify Service in Twilio first.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=
ADMIN_BOOTSTRAP_PHONE=

# Razorpay Checkout and Route. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional browser push (HTTPS required)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Optional request logs; never log request bodies or authorization headers.
LOG_REQUESTS=false
